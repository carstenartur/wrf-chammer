    ".gitignore",
    "LICENSE",
    "Dockerfile.backend",
    "Dockerfile.era5",
    "Dockerfile.postproc",
    "Dockerfile.postprocessing"
  ],
  "path_renames": {
    "migration/standalone-root/": ""
  },
  "allowed_export_roots": [
    ".github",
    ".gitignore",
    "CHANGELOG.md",
    "Dockerfile.backend",
    "Dockerfile.era5",
    "Dockerfile.postproc",
    "Dockerfile.postprocessing",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "ci",
    "doc",
    "migration-report.json",
    "runtime",
    "tests",
    "visualization",
    "workbench",
    "wrf-chammer"
  ],
  "required_export_paths": [
    "README.md",
    "wrf-chammer",
    "workbench/cli.py",
    "workbench/server/application.py",
    "workbench/simulation_store.py",
    "workbench/simulation_run_manifest.py",
