{
  "private": true,
  "name": "wrf-workbench-e2e",
  "version": "0.1.0",
  "description": "Browser tests and user-guide screenshot generation for the WRF Workbench.",
  "scripts": {
    "test": "npm run screenshots:smoke",
    "screenshots:smoke": "playwright test xaver-user-guide.spec.js --project=chromium",
    "screenshots:docs": "playwright test xaver-user-guide.spec.js xaver-weather-map.spec.js --project=chromium",
    "screenshots": "npm run screenshots:docs",
    "screenshots:container": "node run-testcontainers-screenshots.js"
  },
  "devDependencies": {
    "@playwright/test": "1.53.0",
    "testcontainers": "^10.16.0"
  }
}
