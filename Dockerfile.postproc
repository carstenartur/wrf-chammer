# syntax=docker/dockerfile:1
# Post-processing worker for WRF Workbench.
#
# Responsibilities (see doc/ARCHITECTURE.md §4.4):
#   - Convert wrfout_d* NetCDF files to user-requested formats (GeoTIFF, CSV
#     time-series, compressed NetCDF).
#   - Generate summary statistics and diagnostics.
#   - Upload derived products to Object Storage.
#   - Emit a postprocessing.completed event.
#
# This image is a placeholder.  The full post-processing implementation is
# tracked in a separate issue.

FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir \
        netCDF4 \
        numpy \
        xarray

# Placeholder entry point — the real worker will be installed as a package.
CMD ["python3", "-c", "print('post-processing worker: not yet implemented')"]
